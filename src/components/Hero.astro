<script>
  document.getElementById('copyBtn')?.addEventListener('click', () => {
    const cmd = "curl -fsSL https://raw.githubusercontent.com/utajum/sonar-scanner/refs/heads/master/install.sh | bash";
    navigator.clipboard.writeText(cmd).then(() => {
      const copyIcon = document.querySelector('.copy-icon') as HTMLElement;
      const checkIcon = document.querySelector('.check-icon') as HTMLElement;
      if (copyIcon && checkIcon) {
        copyIcon.style.display = 'none';
        checkIcon.style.display = 'block';
        setTimeout(() => {
          copyIcon.style.display = 'block';
          checkIcon.style.display = 'none';
        }, 2000);
      }
    });
  });

  // Hacker typing effect for install command
  const lines = [
    { prompt: '$ ', text: 'curl -fsSL https://raw.githubusercontent.com/utajum/' },
    { prompt: '  ', text: 'sonar-scanner/refs/heads/master/install.sh | bash' },
  ];

  const codeEl = document.getElementById('terminalCode');
  const cursorEl = document.querySelector('.cursor') as HTMLElement;
  let lineIdx = 0;
  let charIdx = 0;
  let currentHtml = '';

  function typeChar() {
    if (!codeEl) return;
    const line = lines[lineIdx];

    if (charIdx === 0) {
      currentHtml += `<span class="prompt">${line.prompt}</span>`;
      codeEl.innerHTML = currentHtml;
    }

    if (charIdx < line.text.length) {
      currentHtml += line.text[charIdx];
      codeEl.innerHTML = currentHtml;
      charIdx++;
      setTimeout(typeChar, 20 + Math.random() * 30);
    } else {
      lineIdx++;
      charIdx = 0;
      if (lineIdx < lines.length) {
        currentHtml += '<br/>';
        setTimeout(typeChar, 200);
      } else {
        if (cursorEl) cursorEl.classList.add('blink');
      }
    }
  }

  const terminal = document.getElementById('installTerminal');
  if (terminal) {
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        observer.disconnect();
        setTimeout(typeChar, 500);
      }
    }, { threshold: 0.5 });
    observer.observe(terminal);
  }
</script>

