---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Showcase from '../components/Showcase.astro';
import Usage from '../components/Usage.astro';
import Demo from '../components/Demo.astro';
import Features from '../components/Features.astro';
import Requirements from '../components/Requirements.astro';
import CallToAction from '../components/CallToAction.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Hero />
  <Showcase />
  <Usage />
  <Demo />
  <Features />
  <Requirements />
  <CallToAction />
  <Footer />
</Layout>

<style is:global>
  /* ── Shared Layout ── */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 5rem 0;
    background: var(--bg-dark);
  }

  .section-dark {
    background: var(--bg-deep);
  }

  .section h2 {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
    text-align: center;
  }

  .section-desc {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  /* ── Shared Buttons ── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.5rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.15s ease;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: var(--neon-cyan);
    color: #0d1117;
  }

  .btn-primary:hover {
    background: #33ffff;
    box-shadow: 0 0 20px rgba(0, 255, 255, 0.3);
  }

  .btn-outline {
    background: transparent;
    color: var(--text-primary);
    border: 1.5px solid var(--border-dark);
  }

  .btn-outline:hover {
    border-color: var(--neon-cyan);
    color: var(--neon-cyan);
    background: rgba(0, 255, 255, 0.05);
  }

  /* ── Shared Links ── */
  a {
    color: inherit;
  }

  /* ── Accessibility ── */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Shared Responsive ── */
  @media (max-width: 820px) {
    .hero-buttons {
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .section {
      padding: 3.5rem 0;
    }
  }
</style>
