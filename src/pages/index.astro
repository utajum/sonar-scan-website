  <script>
    document.getElementById('copyBtn')?.addEventListener('click', () => {
      const cmd = "curl -fsSL https://raw.githubusercontent.com/utajum/sonar-scanner/refs/heads/master/install.sh | bash";
      navigator.clipboard.writeText(cmd).then(() => {
        const copyIcon = document.querySelector('.copy-icon') as HTMLElement;
        const checkIcon = document.querySelector('.check-icon') as HTMLElement;
        if (copyIcon && checkIcon) {
          copyIcon.style.display = 'none';
          checkIcon.style.display = 'block';
          setTimeout(() => {
            copyIcon.style.display = 'block';
            checkIcon.style.display = 'none';
          }, 2000);
        }
      });
    });

    // Hacker typing effect
    const lines = [
      { prompt: '$ ', text: 'curl -fsSL https://raw.githubusercontent.com/utajum/' },
      { prompt: '  ', text: 'sonar-scanner/refs/heads/master/install.sh | bash' },
    ];

    const codeEl = document.getElementById('terminalCode');
    const cursorEl = document.querySelector('.cursor') as HTMLElement;
    let lineIdx = 0;
    let charIdx = 0;
    let currentHtml = '';

    function typeChar() {
      if (!codeEl) return;
      const line = lines[lineIdx];

      if (charIdx === 0) {
        currentHtml += `<span class="prompt">${line.prompt}</span>`;
        codeEl.innerHTML = currentHtml;
      }

      if (charIdx < line.text.length) {
        currentHtml += line.text[charIdx];
        codeEl.innerHTML = currentHtml;
        charIdx++;
        setTimeout(typeChar, 20 + Math.random() * 30);
      } else {
        lineIdx++;
        charIdx = 0;
        if (lineIdx < lines.length) {
          currentHtml += '<br/>';
          setTimeout(typeChar, 200);
        } else {
          if (cursorEl) cursorEl.classList.add('blink');
        }
      }
    }

    const terminal = document.querySelector('.terminal');
    if (terminal) {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          setTimeout(typeChar, 500);
        }
      }, { threshold: 0.5 });
      observer.observe(terminal);
    }

    // Usage terminal typing animations
    function typeCommand(el: HTMLElement, command: string, callback?: () => void) {
      const cmdSpan = el.querySelector('.typed-cmd') as HTMLElement;
      const cursorSpan = el.querySelector('.ut-cursor') as HTMLElement;
      if (!cmdSpan || !cursorSpan) return;

      let i = 0;
      cursorSpan.classList.remove('blink');

      function tick() {
        if (i < command.length) {
          cmdSpan.textContent = command.slice(0, i + 1);
          i++;
          setTimeout(tick, 35 + Math.random() * 40);
        } else {
          cursorSpan.classList.add('blink');
          if (callback) callback();
        }
      }
      tick();
    }

    const usageTerminals = document.querySelectorAll('.usage-terminal');
    const usageObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          usageObserver.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const command = el.dataset.command || '';
          // Stagger based on position in grid
          const allTerminals = Array.from(usageTerminals);
          const idx = allTerminals.indexOf(el);
          setTimeout(() => {
            typeCommand(el, command);
          }, idx * 150);
        }
      });
    }, { threshold: 0.3 });

    usageTerminals.forEach((t) => usageObserver.observe(t));
  </script>

