---
import PostHog from "../components/posthog.astro";
const siteUrl = 'https://sonar-scanner.elevatech.xyz';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="utajum" />
    <link rel="canonical" href={siteUrl} />

    <title>sonar-scan | Zero-Config Code Vulnerability Scanner</title>
    <meta
      name="description"
      content="Zero-configuration SonarQube wrapper for effortless code scanning. Auto-deploys SonarQube in Docker, handles authentication, purges old data, and delivers vulnerability reports. One command, full results."
    />
    <meta
      name="keywords"
      content="sonarqube, sonar-scan, code vulnerability, static analysis, code quality, docker, bash, cli, security scanner, sonar-scanner, devops, linux"
    />

    <!-- OpenGraph -->
    <meta property="og:title" content="sonar-scan | Zero-Config Code Vulnerability Scanner" />
    <meta
      property="og:description"
      content="Zero-configuration SonarQube wrapper. Auto-deploys SonarQube in Docker, scans your codebase, delivers vulnerability reports. One command, full results."
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content="sonar-scan" />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="sonar-scan — zero-configuration SonarQube code vulnerability scanner with retro terminal interface" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="sonar-scan | Zero-Config Code Vulnerability Scanner" />
    <meta
      name="twitter:description"
      content="Zero-configuration SonarQube wrapper. Auto-deploys SonarQube in Docker, scans your codebase, delivers vulnerability reports. One command, full results."
    />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
    <meta name="twitter:image:alt" content="sonar-scan — zero-configuration SonarQube code vulnerability scanner with retro terminal interface" />

    <meta name="theme-color" content="#121417" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "http://schema.org",
      "@type": "SoftwareApplication",
      "name": "sonar-scan",
      "operatingSystem": "Linux, macOS",
      "applicationCategory": "DeveloperApplication",
      "description": "Zero-configuration SonarQube wrapper for effortless code scanning. Auto-deploys SonarQube in Docker, handles authentication, purges old data, and delivers full vulnerability reports with a single command.",
      "url": siteUrl,
      "downloadUrl": "https://github.com/utajum/sonar-scanner",
      "softwareVersion": "1.0.0",
      "image": `${siteUrl}/og-image.png`,
      "screenshot": `${siteUrl}/screenshot-banner.png`,
      "author": {
        "@type": "Person",
        "name": "utajum",
        "url": "https://github.com/utajum"
      },
      "license": "https://github.com/utajum/sonar-scanner/blob/master/LICENSE",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "sameAs": [
        "https://github.com/utajum/sonar-scanner"
      ]
    })} />
  </head>
  <body>
    <slot />
    <PostHog />
  </body>
</html>

<style is:global>
  :root {
    --neon-cyan: #00ffff;
    --neon-green: #00ff41;
    --neon-purple: #af00ff;
    --neon-pink: #ff00ff;
    --neon-orange: #ff8700;
    --neon-yellow: #ffff00;
    --bg-deep: #0d1117;
    --bg-dark: #121417;
    --bg-card: #161b22;
    --bg-card-hover: #1c2129;
    --border-dark: #30363d;
    --border-hover: #484f58;
    --text-primary: #e6edf3;
    --text-muted: #8b949e;
    --text-dim: #6e7681;
    --radius: 12px;
    --radius-sm: 8px;
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif;
    line-height: 1.6;
    background: var(--bg-deep);
    color: var(--text-primary);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
</style>
